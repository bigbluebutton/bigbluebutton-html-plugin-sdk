{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "lib": [
      "dom",
      "esnext"
    ],
    "types": ["node"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "outDir": "./dist/cjs",
    "sourceMap": true,
    "strict": true,
    "target": "es5",
    "rootDir": "./src"
  },
  "include": [
    "src/**/*.ts"
  ]
}
