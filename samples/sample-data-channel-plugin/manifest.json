{
  "requiredSdkVersion": "^1.0.0-beta.2",
  "name": "SampleDataChannelPlugin",
  "version": "0.0.8-beta1",
  "javascriptEntrypointUrl": "SampleDataChannelPlugin.js",
  "localesBaseUrl": "https://cdn.dominio.com/pluginabc/",
  "loggerSettings": {
    "console": {
      "level": "error"
    }
  },
  "dataChannels": [
    {
      "name": "public-channel",
      "pushPermission": [
        "moderator",
        "presenter"
      ],
